# Copy to .env and fill in. Never commit the filled-in file.

# --- policy model under evaluation (OpenAI-compatible server) ---
GENERATOR_API_BASE=http://localhost:8000/v1
GENERATOR_MODEL=your-policy-model-name
GENERATOR_API_KEY=EMPTY

# --- frozen auxiliary repair model ---
CORRECTOR_API_URL=https://openrouter.ai/api/v1/chat/completions
CORRECTOR_MODEL=your-corrector-model-name
CORRECTOR_API_KEY=

